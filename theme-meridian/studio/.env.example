# Sanity project credentials (same as app)
SANITY_STUDIO_PROJECT_ID=your-project-id
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_API_VERSION=2024-12-01

# App URL for preview links in standalone studio
SANITY_STUDIO_BASE_URL=http://localhost:3000

# App origin the Styleguide tool iframes from, when running the STANDALONE studio
# (different origin than the app). The embedded /admin ignores this and uses its
# own origin so the iframe follows the current deployment/branch.
SANITY_STUDIO_APP_URL=http://localhost:3000

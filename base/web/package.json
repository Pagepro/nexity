{
  "name": "@nexity/web",
  "version": "1.0.0",
  "description": "Sanity & Next.js 16 Starter",
  "author": "Pagepro (https://pagepro.co)",
  "license": "MIT",
  "private": true,
  "scripts": {
    "predev": "pnpm envs:validate && pnpm ts:typegen",
    "prebuild": "pnpm envs:validate && pnpm ts:typegen",
    "dev": "next dev",
    "dev:web": "next dev",
    "build": "pnpm manifest && next build",
    "start": "next start",
    "manifest": "sanity manifest extract --path public/admin/static",
    "ts:extract": "sanity schema extract --enforce-required-fields --force",
    "ts:generate": "sanity typegen generate",
    "ts:typegen": "pnpm ts:extract && pnpm ts:generate",
    "typecheck": "tsc --noEmit",
    "check:client": "node scripts/check-client-boundaries.mjs",
    "envs:validate": "tsx ./src/scripts/validateEnvs.ts",
    "test": "node --experimental-strip-types --import ./scripts/test/register-resolve.mjs --test \"scripts/**/*.test.mjs\" \"src/**/*.test.mts\""
  },
  "dependencies": {
    "@c15t/integrations": "^3.1.0",
    "@c15t/nextjs": "^3.1.0",
    "@c15t/react": "^3.1.0",
    "@nexity/studio": "workspace:*",
    "@portabletext/react": "^8.0.1",
    "@sanity/asset-utils": "^2.3.0",
    "@sanity/assist": "^6.2.5",
    "@sanity/client": "^8.11.0",
    "@sanity/code-input": "^7.3.14",
    "@sanity/dashboard": "^6.0.22",
    "@sanity/icons": "^5.2.3",
    "@sanity/image-url": "^2.1.1",
    "@sanity/ui": "^4.4.10",
    "@sanity/vision": "^6.20.0",
    "@svgr/webpack": "^8.1.0",
    "@tabler/icons-react": "^3.49.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel": "^8.6.0",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "groq": "^6.20.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "next-sanity": "^13.3.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "resend": "^6.34.1",
    "sanity": "^6.20.0",
    "sanity-plugin-dashboard-widget-vercel": "^4.0.32",
    "sanity-plugin-iframe-pane": "^5.0.42",
    "sanity-plugin-media": "^6.5.0",
    "sanity-plugin-simpler-color-input": "^4.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^18.0.9",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plugin-svgr": "^5.2.0"
  }
}
